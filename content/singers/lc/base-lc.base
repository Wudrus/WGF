filters:
  and:
    - file.hasProperty("song")
    - singers.containsAny(link("Albina"), link("Callisto"), link("Don Quixote"), link("Faust"), link("Ishmael"), link("Lucio"), link("Meursault"), link("Nicolina"), link("Outis"), link("Time Ripper"), link("Valencina"), link("Yi Sang"))
formulas:
  Песня: file.asLink(file.properties.title)
properties:
  note.singers:
    displayName: Певцы
  file.tags:
    displayName: Теги
views:
  - type: table
    name: Общий вид
    order:
      - formula.Песня
      - singers
    columnSize:
      formula.Песня: 356
      note.singers: 228
    rowHeight: medium
